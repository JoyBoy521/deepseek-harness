pipeline {
    agent any

    options {
        // 发布是有风险的动作：同一时间只允许一个，避免互相回滚/覆盖
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    parameters {
        // 用 Git Parameter 直接列仓库里的 Tag —— 官方插件、无需脚本审批、无需凭据
        // 镜像 tag 与 Git tag 一一对应，所以选 Git tag 就等于选镜像版本
        gitParameter(name: 'GIT_TAG', type: 'PT_TAG', defaultValue: '',
                     tagFilter: 'v(.*)',
                     sortMode: 'DESCENDING_SMART',
                     description: '选择要发布的 Git 标签（镜像 tag 与之一一对应）')
        choice(name: 'TARGET_ENV', choices: ['staging', 'prod'], description: '发布到哪个环境')
    }

    environment {
        REGISTRY = "192.168.187.128:8088"
        PROJECT  = "joyboy"
        IMAGE    = "${REGISTRY}/${PROJECT}/deepseek-harness"
    }

    stages {
        stage('参数校验与环境推导') {
            steps {
                script {
                    if (!params.GIT_TAG?.trim()) {
                        error('❌ 必须选择 GIT_TAG（要发布哪个 Git 标签，见下拉列表）')
                    }
                    // 约定：镜像 tag == Git tag
                    env.IMAGE_TAG  = params.GIT_TAG
                    env.TARGET_ENV = params.TARGET_ENV
                    env.CONTAINER  = "deepseek-harness-${params.TARGET_ENV}"
                    env.PORT       = (params.TARGET_ENV == 'prod') ? '8084' : '8083'
                    env.APP_ENV    = params.TARGET_ENV
                    echo "环境 = ${env.APP_ENV} | 容器 = ${env.CONTAINER} | 端口 = ${env.PORT} | 版本 = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('生产发布审批') {
            when { expression { params.TARGET_ENV == 'prod' } }
            steps {
                input message: "确认将 ${params.GIT_TAG} 发布到【生产环境 prod / 8084】？", ok: '批准发布'
            }
        }

        stage('校验镜像存在') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-cred',
                                                  usernameVariable: 'HARBOR_USER',
                                                  passwordVariable: 'HARBOR_PASS')]) {
                    sh '''
                    echo "$HARBOR_PASS" | docker login "$REGISTRY" -u "$HARBOR_USER" --password-stdin
                    # 用 docker pull 校验（daemon 侧操作，可靠）；manifest inspect 对 http 仓库会误报
                    if ! docker pull "$IMAGE:$IMAGE_TAG"; then
                      echo "❌ 拉取失败：Harbor 里没有这个版本，或没有拉取权限 -> $IMAGE:$IMAGE_TAG"
                      echo "   提示：请确认该 Git tag 已经跑过 CI 线并成功推送到 Harbor"
                      exit 1
                    fi
                    echo "✅ 版本存在且已拉到本地"
                    '''
                }
            }
        }

        stage('记录回滚点') {
            steps {
                sh '''
                mkdir -p "$JENKINS_HOME/releases"
                PREV=$(docker inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null | sed 's/.*://' || true)
                echo "${PREV:-none}" > "$JENKINS_HOME/releases/last_good_${TARGET_ENV}.txt"
                echo "回滚点已记录: ${PREV:-none}"
                '''
            }
        }

        stage('执行部署') {
            steps {
                withCredentials([string(credentialsId: 'deepseek-api-key', variable: 'API_KEY')]) {
                    sh '''
                    docker stop "$CONTAINER" || true
                    docker rm "$CONTAINER" || true
                    docker run -d --name "$CONTAINER" --restart unless-stopped -p "${PORT}:8082" \
                      -v "dsh-data-${TARGET_ENV}:/root/.dsh" \
                      -e DEEPSEEK_API_KEY="$API_KEY" \
                      -e DEEPSEEK_BASE_URL="https://api.deepseek.com" \
                      -e APP_ENV="$APP_ENV" \
                      -e APP_VERSION="$IMAGE_TAG" \
                      "$IMAGE:$IMAGE_TAG"
                    '''
                }
            }
        }

        stage('健康检查') {
            steps {
                sh '''
                for i in $(seq 1 40); do
                  if docker exec "$CONTAINER" node -e "fetch('http://127.0.0.1:8082').then(r=>process.exit(r.status>=500?1:0)).catch(()=>process.exit(1))" 2>/dev/null; then
                    echo "✅ $TARGET_ENV 健康检查通过"; exit 0
                  fi
                  echo "第 $i 次检查未就绪，5 秒后重试…"
                  sleep 5
                done
                echo "❌ 健康检查失败"; docker logs "$CONTAINER" --tail 40; exit 1
                '''
            }
        }

        stage('记录发布台账') {
            steps {
                sh '''
                printf "%s | RELEASE | %s | %s | build#%s\n" \
                  "$(date '+%F %T')" "$TARGET_ENV" "$IMAGE_TAG" "$BUILD_NUMBER" \
                  >> "$JENKINS_HOME/releases/deployments.log"
                echo "---- 最近 10 条发布记录 ----"
                tail -10 "$JENKINS_HOME/releases/deployments.log"
                '''
            }
        }
    }

    post {
        success {
            sh '''
            for i in $(seq 1 30); do
              TOKEN=$(docker logs "$CONTAINER" 2>/dev/null | grep -o 'token=[A-Za-z0-9_-]*' | tail -1 | sed 's/token=//')
              if [ -n "$TOKEN" ]; then break; fi
              sleep 5
            done
            echo "✅ 发布成功: $TARGET_ENV <- $IMAGE_TAG"
            echo "版本来源: Git tag $IMAGE_TAG（与镜像 tag 一一对应）"
            if [ -n "$TOKEN" ]; then
              echo "访问地址: http://192.168.187.128:${PORT}/?token=$TOKEN"
            fi
            '''
        }
        failure {
            withCredentials([
                usernamePassword(credentialsId: 'harbor-cred', usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS'),
                string(credentialsId: 'deepseek-api-key', variable: 'API_KEY')
            ]) {
                sh '''
                echo "❌ 发布失败，开始自动回滚…"
                PREV=$(cat "$JENKINS_HOME/releases/last_good_${TARGET_ENV}.txt" 2>/dev/null)
                if [ -z "$PREV" ] || [ "$PREV" = "none" ]; then
                  echo "⚠️ 没有可用的回滚点，请人工处理（当前容器状态）:"
                  docker ps -a --filter "name=deepseek-harness"
                  exit 0
                fi

                echo "回滚目标版本: $PREV"
                echo "$HARBOR_PASS" | docker login "$REGISTRY" -u "$HARBOR_USER" --password-stdin >/dev/null 2>&1 || true
                docker pull "$IMAGE:$PREV" || true
                docker stop "$CONTAINER" || true
                docker rm "$CONTAINER" || true
                docker run -d --name "$CONTAINER" --restart unless-stopped -p "${PORT}:8082" \
                  -v "dsh-data-${TARGET_ENV}:/root/.dsh" \
                  -e DEEPSEEK_API_KEY="$API_KEY" \
                  -e DEEPSEEK_BASE_URL="https://api.deepseek.com" \
                  -e APP_ENV="$APP_ENV" \
                  -e APP_VERSION="$PREV" \
                  "$IMAGE:$PREV"

                echo "等待回滚后的容器就绪…"
                for i in $(seq 1 30); do
                  if docker exec "$CONTAINER" node -e "fetch('http://127.0.0.1:8082').then(r=>process.exit(r.status>=500?1:0)).catch(()=>process.exit(1))" 2>/dev/null; then
                    echo "✅ 已自动回滚到 $PREV，服务已恢复"
                    printf "%s | ROLLBACK | %s | %s -> %s | build#%s\n" \
                      "$(date '+%F %T')" "$TARGET_ENV" "$IMAGE_TAG" "$PREV" "$BUILD_NUMBER" \
                      >> "$JENKINS_HOME/releases/deployments.log"
                    exit 0
                  fi
                  sleep 5
                done
                echo "❌ 回滚后仍未就绪，请人工介入"; docker logs "$CONTAINER" --tail 40
                '''
            }
        }
        always {
            sh 'docker logout "$REGISTRY" || true'
        }
    }
}
