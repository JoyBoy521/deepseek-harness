pipeline {
    agent any

    options {
        // 同一时间只允许一个构建：避免两次构建抢同一个容器名
        disableConcurrentBuilds()
        // 整条流水线最长 90 分钟，防止卡死（镜像构建慢，留足余量）
        timeout(time: 90, unit: 'MINUTES')
        // Jenkins 只保留最近 30 次构建记录，避免历史堆积
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        gitParameter(name: 'GIT_BRANCH', type: 'PT_BRANCH', branchFilter: 'origin/(.*)',
                     defaultValue: 'master', description: '选择要构建的分支')
        booleanParam(name: 'DEPLOY_DEV', defaultValue: true, description: '构建后部署到 dev 环境')
        booleanParam(name: 'CLEAN_IMAGES', defaultValue: false, description: '清理本地旧镜像')
    }

    environment {
        REGISTRY = "192.168.187.128:8088"
        PROJECT  = "joyboy"
        IMAGE    = "${REGISTRY}/${PROJECT}/deepseek-harness"
        HARBOR_USER = credentials('harbor-user')
        HARBOR_PASS = credentials('harbor-pass')
        DEEPSEEK_API_KEY = credentials('deepseek-api-key')
        APP_ENV = "dev"
        CONTAINER = "deepseek-harness-dev"
        PORT = "8082"
    }

    stages {
        stage('参数回显') {
            steps {
                echo "分支 = ${params.GIT_BRANCH ?: 'master'} | 部署dev = ${params.DEPLOY_DEV} | 清理镜像 = ${params.CLEAN_IMAGES}"
            }
        }

        // 必须先拉代码：后面的 git rev-parse 需要仓库
        stage('拉取项目') {
            steps {
                script {
                    env.GIT_REF = params.GIT_BRANCH ?: 'master'
                }
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/${env.GIT_REF}"]],
                    userRemoteConfigs: [[url: 'https://github.com/JoyBoy521/deepseek-harness.git']]])
            }
        }

        // 镜像标签 = 日期 + u + 构建号 + 提交短哈希（可从镜像追溯源码）
        stage('生成镜像标签') {
            steps {
                script {
                    def date = sh(script: 'date +%Y%m%d', returnStdout: true).trim()
                    def sha  = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.TAG = "${date}u${env.BUILD_NUMBER}-${sha}"
                    env.GIT_SHA = sha
                    echo "分支 = ${env.GIT_REF}，提交 = ${sha}，镜像标签 = ${env.TAG}"
                }
            }
        }

        stage('打包镜像') {
            steps {
                sh 'docker build -t "$IMAGE:$TAG" .'
            }
        }

        stage('推送 Harbor') {
            steps {
                sh '''
                echo "$HARBOR_PASS" | docker login "$REGISTRY" -u "$HARBOR_USER" --password-stdin
                docker push "$IMAGE:$TAG"
                echo "已推送: $IMAGE:$TAG"
                '''
            }
        }

        stage('部署到 dev') {
            when { expression { params.DEPLOY_DEV == true } }
            steps {
                sh '''
                docker pull "$IMAGE:$TAG"
                docker stop "$CONTAINER" || true
                docker rm "$CONTAINER" || true
                docker run -d --name "$CONTAINER" --restart unless-stopped -p "${PORT}:8082" \
                  -v "dsh-data-dev:/root/.dsh" \
                  -e DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" \
                  -e DEEPSEEK_BASE_URL="https://api.deepseek.com" \
                  -e APP_ENV="$APP_ENV" \
                  "$IMAGE:$TAG"
                '''
            }
        }

        stage('健康检查') {
            when { expression { params.DEPLOY_DEV == true } }
            steps {
                sh '''
                for i in $(seq 1 30); do
                  if docker exec "$CONTAINER" node -e "fetch('http://127.0.0.1:8082').then(()=>process.exit(0)).catch(()=>process.exit(1))" 2>/dev/null; then
                    echo "✅ dev 健康检查通过"; exit 0
                  fi
                  sleep 5
                done
                echo "❌ dev 健康检查失败"; docker logs "$CONTAINER" --tail 30; exit 1
                '''
            }
        }

        stage('记录构建台账') {
            steps {
                sh '''
                mkdir -p "$JENKINS_HOME/releases"
                printf "%s | CI | %s | %s | %s | %s | %s\\n" \
                  "$(date '+%F %T')" "$APP_ENV" "$TAG" "$GIT_REF" "$GIT_SHA" "$BUILD_NUMBER" \
                  >> "$JENKINS_HOME/releases/builds.log"
                echo "---- 最近 5 条构建记录 ----"
                tail -5 "$JENKINS_HOME/releases/builds.log"
                '''
            }
        }

        stage('清理本地旧镜像') {
            when { expression { params.CLEAN_IMAGES == true } }
            steps {
                sh '''
                docker image prune -f
                # 本地只留最近 5 个版本（完整版本都在 Harbor 里，不心疼）
                docker images "$IMAGE" --format "{{.CreatedAt}}\t{{.Tag}}" | sort -r | tail -n +6 \
                  | awk '{print $NF}' | xargs -I {} docker rmi "$IMAGE:{}" || true
                '''
            }
        }
    }

    post {
        success {
            sh '''
            TOKEN=$(docker logs "$CONTAINER" 2>/dev/null | grep -o 'token=[A-Za-z0-9_-]*' | tail -1 | sed 's/token=//')
            echo "✅ CI 完成"
            echo "镜像已入库: $IMAGE:$TAG"
            echo "源码: $GIT_REF @ $GIT_SHA"
            echo "dev 访问: http://192.168.187.128:8082/?token=$TOKEN"
            '''
        }
        failure {
            echo "❌ CI 失败（不影响线上，可重跑）"
        }
        always {
            // 无论成败都清掉 Harbor 凭据，避免留在 Jenkins 容器里
            sh 'docker logout "$REGISTRY" || true'
        }
    }
}
