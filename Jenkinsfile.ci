pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        // 正式发布：选一个 Git Tag（镜像 tag 与之一一对应）
        gitParameter(name: 'GIT_TAG', type: 'PT_TAG', defaultValue: '',
                     tagFilter: 'v(.*)',
                     sortMode: 'DESCENDING_SMART',
                     description: '选择要构建的 Git 标签（正式发布用；留空 = 用分支最新提交）')
        // 日常开发：选分支
        gitParameter(name: 'GIT_BRANCH', type: 'PT_BRANCH', branchFilter: 'origin/(.*)',
                     defaultValue: 'master', description: '分支（未选 Tag 时使用）')
        booleanParam(name: 'DEPLOY_DEV', defaultValue: true, description: '构建后部署到 dev 环境')
        booleanParam(name: 'CLEAN_IMAGES', defaultValue: false, description: '清理本地旧镜像')
    }

    environment {
        REGISTRY  = "192.168.187.128:8088"
        PROJECT   = "joyboy"
        IMAGE     = "${REGISTRY}/${PROJECT}/deepseek-harness"
        APP_ENV   = "dev"
        CONTAINER = "deepseek-harness-dev"
        PORT      = "8082"
    }

    stages {
        stage('拉取项目') {
            steps {
                script {
                    // 选了 Tag 就检出 tag（refs/tags/xxx），否则检出分支（*/xxx）
                    env.GIT_REF = params.GIT_TAG ? "refs/tags/${params.GIT_TAG}"
                                                 : "*/${params.GIT_BRANCH ?: 'master'}"
                    echo "本次检出: ${env.GIT_REF}"
                }
                checkout([$class: 'GitSCM',
                    branches: [[name: "${env.GIT_REF}"]],
                    userRemoteConfigs: [[url: 'https://github.com/JoyBoy521/deepseek-harness.git']]])
            }
        }

        stage('生成镜像标签') {
            steps {
                script {
                    def sha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_SHA = sha
                    if (params.GIT_TAG) {
                        // 正式发布：镜像 tag == Git tag（一一对应，可追溯、可回滚）
                        env.TAG = params.GIT_TAG
                        env.IS_RELEASE = 'true'
                    } else {
                        // 日常开发构建：日期 + 构建号 + 短哈希
                        def date = sh(script: 'date +%Y%m%d', returnStdout: true).trim()
                        env.TAG = "${date}u${env.BUILD_NUMBER}-${sha}"
                        env.IS_RELEASE = 'false'
                    }
                    echo "镜像标签 = ${env.TAG}（正式发布: ${env.IS_RELEASE}），提交 = ${sha}"
                }
            }
        }

        stage('打包镜像') {
            steps {
                sh 'docker build --build-arg GIT_COMMIT="$GIT_SHA" -t "$IMAGE:$TAG" .'
            }
        }

        stage('推送 Harbor') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-cred',
                                                  usernameVariable: 'HARBOR_USER',
                                                  passwordVariable: 'HARBOR_PASS')]) {
                    sh '''
                    echo "$HARBOR_PASS" | docker login "$REGISTRY" -u "$HARBOR_USER" --password-stdin
                    docker push "$IMAGE:$TAG"
                    echo "已推送: $IMAGE:$TAG"
                    '''
                }
            }
        }

        stage('部署到 dev') {
            when { expression { params.DEPLOY_DEV == true } }
            steps {
                withCredentials([string(credentialsId: 'deepseek-api-key', variable: 'API_KEY')]) {
                    sh '''
                    docker pull "$IMAGE:$TAG"
                    docker stop "$CONTAINER" || true
                    docker rm "$CONTAINER" || true
                    docker run -d --name "$CONTAINER" --restart unless-stopped -p "${PORT}:8082" \
                      -v "dsh-data-dev:/root/.dsh" \
                      -e DEEPSEEK_API_KEY="$API_KEY" \
                      -e DEEPSEEK_BASE_URL="https://api.deepseek.com" \
                      -e APP_ENV="$APP_ENV" \
                      "$IMAGE:$TAG"
                    '''
                }
            }
        }

        stage('健康检查') {
            when { expression { params.DEPLOY_DEV == true } }
            steps {
                sh '''
                for i in $(seq 1 40); do
                  if docker exec "$CONTAINER" node -e "fetch('http://127.0.0.1:8082').then(r=>process.exit(r.status>=500?1:0)).catch(()=>process.exit(1))" 2>/dev/null; then
                    echo "✅ dev 健康检查通过"; exit 0
                  fi
                  echo "第 $i 次检查未就绪，5 秒后重试…"
                  sleep 5
                done
                echo "❌ dev 健康检查失败"; docker logs "$CONTAINER" --tail 40; exit 1
                '''
            }
        }

        // 正式发布（打了 Git Tag）→ 自动晋级到 staging，由 CD 线负责部署
        stage('晋级到 staging') {
            when { expression { env.IS_RELEASE == 'true' } }
            steps {
                build job: 'deepseek-harness-cd', wait: false,
                      parameters: [
                        string(name: 'GIT_TAG', value: env.TAG),
                        string(name: 'TARGET_ENV', value: 'staging')
                      ]
                echo "已触发 CD 线部署 staging（版本 ${env.TAG}）"
            }
        }

        stage('记录构建台账') {
            steps {
                sh '''
                mkdir -p "$JENKINS_HOME/releases"
                printf "%s | CI | %s | %s | %s | %s | %s | release=%s\n" \
                  "$(date '+%F %T')" "$APP_ENV" "$TAG" "$GIT_REF" "$GIT_SHA" "$BUILD_NUMBER" "$IS_RELEASE" \
                  >> "$JENKINS_HOME/releases/builds.log"
                {
                  echo "$TAG"
                  cat "$JENKINS_HOME/releases/tags.txt" 2>/dev/null
                } | head -50 > "$JENKINS_HOME/releases/tags.txt.new" \
                  && mv "$JENKINS_HOME/releases/tags.txt.new" "$JENKINS_HOME/releases/tags.txt"
                echo "---- 最近 5 条构建记录 ----"
                tail -5 "$JENKINS_HOME/releases/builds.log"
                '''
            }
        }

        stage('清理本地旧镜像') {
            steps {
                sh '''
                # 本地只保留最近 2 个版本（完整版本都在 Harbor 里，随时能拉回来）
                # 每个镜像约 5GB，留太多会把磁盘撑爆
                docker images "$IMAGE" --format "{{.CreatedAt}}\t{{.Tag}}" | sort -r | tail -n +3 \
                  | awk '{print $NF}' | xargs -I {} docker rmi "$IMAGE:{}" || true
                # 悬空镜像（构建中间层）按需清理
                if [ "$CLEAN_IMAGES" = "true" ]; then
                  docker image prune -f
                fi
                df -h / | tail -1
                '''
            }
        }
    }

    post {
        success {
            sh '''
            for i in $(seq 1 30); do
              TOKEN=$(docker logs "$CONTAINER" 2>/dev/null | grep -o 'token=[A-Za-z0-9_-]*' | tail -1 | sed 's/token=//')
              if [ -n "$TOKEN" ]; then break; fi
              sleep 5
            done
            echo "✅ CI 完成（正式发布: $IS_RELEASE）"
            echo "镜像已入库: $IMAGE:$TAG"
            echo "源码: $GIT_REF @ $GIT_SHA"
            if [ -n "$TOKEN" ]; then
              echo "dev 访问: http://192.168.187.128:8082/?token=$TOKEN"
            fi
            '''
        }
        failure {
            echo "❌ CI 失败（不影响线上，可重跑）"
        }
        always {
            sh 'docker logout "$REGISTRY" || true'
        }
    }
}
